---
// The concepts folder: one quiet index of every PagX concept site. On Vercel (project pagx-conceptos) it is the home page.
import { Image } from 'astro:assets'
import '@fontsource/instrument-serif/400.css'
import '@fontsource/instrument-serif/400-italic.css'
import '@fontsource-variable/instrument-sans/wght.css'
import bruma from '../../../assets/higgsfield/bruma-nA.webp'
import cumbre from '../../../assets/higgsfield/cumbre-product.webp'

const concepts = [
  { n: '01', name: 'Sotobosque', kind: 'Perfumería botánica', note: 'Renders de Cycles, una tarde en un solo claro', href: '/conceptos/sotobosque/', img: '/sotobosque/d-plate.webp' },
  { n: '02', name: 'La Villa', kind: 'Proyecto de arquitectura', note: 'Un instituto educativo que crece del lote, en Cycles', href: '/conceptos/villa/', img: '/villa/d-plate.webp' },
  { n: '03', name: 'Bruma', kind: 'Glamping en la montaña', note: 'El valle se llena de niebla con el scroll', href: '/conceptos/bruma/', img: bruma },
  { n: '04', name: 'Cumbre', kind: 'Tienda de café de origen', note: 'Carrito vivo y checkout de demostración', href: '/conceptos/cumbre/', img: cumbre },
]
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conceptos · PagX Studio</title>
    <meta name="description" content="Sitios concepto de PagX Studio: marcas ficticias construidas como si fueran reales." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">PagX Studio · Conceptos</p>
        <h1>Marcas que no existen, <em>construidas como si existieran.</em></h1>
      </header>
      <ol>
        {concepts.map((c) => (
          <li>
            <a href={c.href}>
              <span class="n">{c.n}</span>
              <span class="t">{c.name}</span>
              <span class="k">{c.kind}<br /><small>{c.note}</small></span>
              <span class="img" aria-hidden="true">
                {typeof c.img === 'string' ? <img src={c.img} alt="" loading="lazy" decoding="async" /> : <Image src={c.img} alt="" width={720} loading="lazy" />}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>

<style is:global>
  :root { --ink: #0b0c0a; --bone: #ece6d6; --muted: rgb(236 230 214 / 0.55); --line: rgb(236 230 214 / 0.14); color-scheme: dark; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--ink); color: var(--bone); font: 400 1rem/1.5 'Instrument Sans Variable', system-ui, sans-serif; }
  main { max-width: 84rem; margin: 0 auto; padding: clamp(4rem, 12vh, 9rem) clamp(1rem, 4vw, 3rem) 6rem; }
  .eyebrow { margin: 0 0 1.4rem; font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  h1 { margin: 0 0 clamp(3rem, 9vh, 6rem); max-width: 18ch; font: 400 clamp(2.6rem, 6vw, 5.6rem)/1 'Instrument Serif', serif; letter-spacing: -0.01em; }
  h1 em { color: var(--muted); }
  ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { position: relative; display: grid; grid-template-columns: 3rem 1.3fr 1fr; align-items: center; gap: 1rem; padding: clamp(1.4rem, 3.4vh, 2.4rem) 0; color: inherit; text-decoration: none; }
  .n { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--muted); }
  .t { font: 400 clamp(2.4rem, 5vw, 4.6rem)/1 'Instrument Serif', serif; transition: translate 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .k { font-size: 0.9rem; }
  .k small { color: var(--muted); font-size: 0.8rem; }
  /* the concept's own image follows the row on hover, the only motion on the page */
  .img { position: absolute; right: 0; top: 50%; width: clamp(12rem, 20vw, 18rem); aspect-ratio: 4 / 3; overflow: hidden; border-radius: 2px; pointer-events: none; opacity: 0; translate: 0 -50%; scale: 0.94; transition: opacity 0.5s, scale 0.8s cubic-bezier(0.16, 1, 0.3, 1); z-index: 1; }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  a:hover .img, a:focus-visible .img { opacity: 1; scale: 1; }
  a:hover .t, a:focus-visible .t { translate: 0.6rem 0; font-style: italic; }
  a:focus-visible { outline: 1px solid var(--bone); outline-offset: 4px; }
  @media (max-width: 760px) {
    a { grid-template-columns: 2.4rem 1fr; }
    .k { grid-column: 2; }
    .img { position: static; grid-column: 1 / -1; width: 100%; opacity: 1; translate: none; scale: 1; aspect-ratio: 16 / 9; margin-top: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .t, .img { transition: none; } }
</style>
