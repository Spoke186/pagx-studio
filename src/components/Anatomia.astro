---
// Portfolio "Anatomía de un sitio" (DECISIONS #38): each site as an exploded view of its real layers that assembles
// as you scroll (src/scripts/anatomia.ts). A loader holds the page until every layer is in memory, so it runs smooth.
// Everything readable or clickable is HTML; without WebGL or with reduced motion the projects are a plain list.
import Layout from '../layouts/Layout.astro'
import Header from './Header.astro'
import { dict, whatsappFor, type Lang } from '../i18n'
import '@fontsource/share-tech-mono/400.css'
// the sites' own fonts, for the type specimens of the spec layer (each loads only when drawn)
import '@fontsource/instrument-serif/400.css'
import '@fontsource/pinyon-script/400.css'
import '@fontsource-variable/instrument-sans/wght.css'
import '@fontsource-variable/bodoni-moda/wght.css'
import '@fontsource-variable/funnel-display/wght.css'
import '@fontsource-variable/funnel-sans/wght.css'
import '@fontsource-variable/host-grotesk/wght.css'
import '@fontsource-variable/space-grotesk/wght.css'
import '@fontsource/anton/400.css'
import '@fontsource-variable/anybody/wdth.css'
import '@fontsource-variable/hanken-grotesk/wght.css'

interface Props { lang: Lang }
const t = dict[Astro.props.lang]
const whatsapp = whatsappFor(Astro.props.lang)
const p = t.portfolio
const c = t.concepts
const projects = [
  { key: 'bruma', n: '01', name: c.glamping.name, kind: c.glamping.kind, tag: p.concept, href: '/conceptos/bruma/', ext: false },
  { key: 'cumbre', n: '02', name: c.shop.name, kind: c.shop.kind, tag: p.concept, href: '/conceptos/cumbre/', ext: false },
  { key: 'sotobosque', n: '03', name: p.sotobosque.name, kind: p.sotobosque.kind, tag: p.concept, href: '/conceptos/sotobosque/', ext: false },
  { key: 'villa', n: '04', name: p.villa.name, kind: p.villa.kind, tag: p.villa.tag, href: '/conceptos/villa/', ext: false },
  { key: 'arvena', n: '05', name: p.arvena.name, kind: p.arvena.kind, tag: p.real, href: 'https://shoparvena.com/es', ext: true },
  // built from sites/pagx-architecture into public/ by sync-architecture.sh
  { key: 'architecture', n: '06', name: p.architecture.name, kind: p.architecture.kind, tag: p.concept, href: '/conceptos/architecture/', ext: false },
  // a real site that allows framing, so it opens in a new tab but still goes live inside the frame
  { key: 'dstrto', n: '07', name: p.dstrto.name, kind: p.dstrto.kind, tag: p.real, href: 'https://dstrtoft.com/', ext: true, frame: true },
  // PAGX Drift lives on its own Vercel preview (sites/pagx-drift); framed live like DSTRTO
  { key: 'drift', n: '08', name: p.drift.name, kind: p.drift.kind, tag: p.concept, href: 'https://pagx-drift.vercel.app/', ext: true, frame: true },
]
const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6" /></svg>'
---

<Layout lang={t.lang as Lang} title={p.title} description={p.description} alternate={p.otherHref} theme="dark">
  <div class="an-loader" data-an-loader aria-hidden="true">
    <p class="label">{p.loading}</p>
    <p class="an-count"><span data-an-count>000</span><small>%</small></p>
    <i class="an-bar"><b data-an-bar></b></i>
  </div>
  <Header t={t} other={p.otherHref} />

  <main id="main" class="an" data-an data-sites={JSON.stringify(projects.map((pr) => pr.key))} data-live={JSON.stringify(projects.map((pr) => (pr.ext && !pr.frame ? null : pr.href)))} data-layers={JSON.stringify(p.layers)}>
    <div class="an-stage">
      <canvas class="an-canvas" data-an-canvas aria-hidden="true"></canvas>
      <div class="an-scrim" aria-hidden="true"></div>
      <div class="an-tags" data-an-tags aria-hidden="true"></div>
      <div class="an-live" data-an-live><iframe title={p.live} tabindex="-1"></iframe></div>

      <header class="an-head wrap">
        <p class="eyebrow"><span>04</span> {t.nav.portfolio}</p>
        <h1 class="an-title display-xl">{p.heading}</h1>
        <button class="an-hint label" type="button" data-an-toggle data-assemble={p.assemble} data-explode={p.explode}>
          <span data-an-hint data-touch={p.hintTouch}>{p.hint}</span>
        </button>
      </header>

      <ol class="an-cards" aria-label={p.chapters}>
        {projects.map((pr, i) => (
          <li class="an-card" data-an-card aria-current={i === 0 ? 'true' : undefined}>
            <img class="an-shot" src={`/portafolio/anatomia/${pr.key}-full.webp`} alt="" width="1280" height="800" loading="lazy" />
            <p class="an-meta"><b>{pr.n}</b> / {String(projects.length).padStart(2, '0')} · {pr.tag}</p>
            <h2 class="an-name">{pr.name}</h2>
            <p class="an-kind muted">{pr.kind}</p>
            <a class="btn btn-secondary btn-sm" href={pr.href} {...(pr.ext ? { target: '_blank', rel: 'noopener' } : {})}>
              <span class="btn-label">{p.enter}</span><span class="btn-icon" aria-hidden="true" set:html={arrow} />
            </a>
          </li>
        ))}
      </ol>

      <nav class="an-controls" aria-label={p.chapters}>
        <button class="an-arrow" type="button" data-an-prev aria-label={p.prev}><span set:html={arrow} /></button>
        <ol>
          {projects.map((pr, i) => (
            <li><button type="button" data-an-go aria-current={i === 0 ? 'true' : undefined}><b>{pr.n}</b><span>{pr.name}</span></button></li>
          ))}
        </ol>
        <button class="an-arrow" type="button" data-an-next aria-label={p.next}><span set:html={arrow} /></button>
      </nav>

      <div class="an-end">
        <p class="an-end-title">{p.endTitle}</p>
        <a class="btn btn-primary btn-sm" href={whatsapp} target="_blank" rel="noopener"><span class="btn-label">{t.hero.cta}</span><span class="btn-icon" aria-hidden="true" set:html={arrow} /></a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { bootSite } from '../scripts/site'
  import { createClock, gsap } from '@pagx/motion'
  bootSite()

  document.addEventListener('astro:page-load', async () => {
    const root = document.querySelector<HTMLElement>('[data-an]')
    const loader = document.querySelector<HTMLElement>('[data-an-loader]')
    if (!root || !loader) return
    const html = document.documentElement
    const hideLoader = () => gsap.to(loader, { autoAlpha: 0, duration: 0.7, ease: 'power2.inOut' })
    if (html.dataset.tier === 'static') return hideLoader()
    const count = loader.querySelector<HTMLElement>('[data-an-count]')!
    const bar = loader.querySelector<HTMLElement>('[data-an-bar]')!
    const shown = { v: 0 }
    const progress = (p: number) => gsap.to(shown, { v: p * 100, duration: 0.4, ease: 'none', overwrite: true, onUpdate: () => { count.textContent = String(Math.round(shown.v)).padStart(3, '0'); bar.style.scale = `${shown.v / 100} 1` } })

    const cards = [...root.querySelectorAll<HTMLElement>('[data-an-card]')]
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-an-go]')]
    const toggle = root.querySelector<HTMLButtonElement>('[data-an-toggle]')!
    const hint = root.querySelector<HTMLElement>('[data-an-hint]')!
    if (matchMedia('(pointer: coarse)').matches) hint.textContent = hint.dataset.touch!
    const clock = createClock({ smooth: false })
    const { mountAnatomy } = await import('../scripts/anatomia')
    const an = await mountAnatomy(
      root.querySelector('[data-an-canvas]')!, clock.add, JSON.parse(root.dataset.sites!),
      { root: root.querySelector('[data-an-tags]')!, names: JSON.parse(root.dataset.layers!) },
      progress,
      (done) => { root.classList.toggle('is-assembled', done); hint.textContent = done ? toggle.dataset.explode! : toggle.dataset.assemble! },
    ).catch(() => null)
    await progress(1).then()
    gsap.delayedCall(0.25, hideLoader)
    if (!an) return html.setAttribute('data-tier', 'static') // no WebGL: the plain list
    root.classList.add('is-live')

    // once a site is assembled and still, the real site takes over its frame and can be scrolled
    const live = root.querySelector<HTMLElement>('[data-an-live]')!
    const frame = live.querySelector('iframe')!
    const hrefs: (string | null)[] = JSON.parse(root.dataset.live!)
    let shownLive = false
    const offLive = clock.add(() => {
      const r = an.frame()
      const href = hrefs[i]
      const on = !!r && !!href && innerWidth > 760 // on phones the frame is too small to browse
      if (on) {
        if (frame.dataset.src !== href) { frame.dataset.src = href!; frame.src = href! }
        const sc = r!.width / 1440
        live.style.transform = `translate(${r!.left}px, ${r!.top}px)`
        frame.style.transform = `scale(${sc})`
        live.style.width = `${r!.width}px`; live.style.height = `${r!.height}px`
      }
      if (on !== shownLive) { shownLive = on; live.classList.toggle('is-on', on); frame.tabIndex = on ? 0 : -1 }
    })

    let i = 0
    const show = (n: number) => {
      const k = ((n % cards.length) + cards.length) % cards.length
      if (k === i) return
      an.go(k)
      cards.forEach((c, j) => (j === k ? c.setAttribute('aria-current', 'true') : c.removeAttribute('aria-current')))
      dots.forEach((d, j) => (j === k ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')))
      i = k
    }
    root.querySelector('[data-an-next]')!.addEventListener('click', () => show(i + 1))
    root.querySelector('[data-an-prev]')!.addEventListener('click', () => show(i - 1))
    dots.forEach((d, j) => d.addEventListener('click', () => show(j)))
    toggle.addEventListener('click', () => an.toggle())
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'ArrowRight') show(i + 1)
      if (e.key === 'ArrowLeft') show(i - 1)
      if (e.key === 'ArrowDown') an.nudge(0.25)
      if (e.key === 'ArrowUp') an.nudge(-0.25)
    }
    const onWheel = (e: WheelEvent) => an.nudge(e.deltaY / 900)
    let y0 = 0, x0 = 0
    const onStart = (e: TouchEvent) => { y0 = e.touches[0].clientY; x0 = e.touches[0].clientX }
    const onTouch = (e: TouchEvent) => { const y = e.touches[0].clientY; an.nudge((y0 - y) / 500); y0 = y }
    const onEnd = (e: TouchEvent) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 60) show(i - Math.sign(dx)) }
    addEventListener('keydown', onKey)
    addEventListener('wheel', onWheel, { passive: true })
    root.addEventListener('touchstart', onStart, { passive: true })
    root.addEventListener('touchmove', onTouch, { passive: true })
    root.addEventListener('touchend', onEnd)
    document.addEventListener('astro:before-swap', () => { offLive(); an.destroy(); removeEventListener('keydown', onKey); removeEventListener('wheel', onWheel) }, { once: true })
  })
</script>

<style>
  .an-loader { position: fixed; inset: 0; z-index: 90; display: grid; place-content: center; justify-items: center; gap: 14px; background: var(--color-bg); }
  .an-count { font-size: clamp(5rem, 16vw, 12rem); line-height: .85; letter-spacing: -0.06em; font-variation-settings: "wght" 600; font-variant-numeric: tabular-nums; }
  .an-count small { font-size: .25em; letter-spacing: 0; color: var(--color-c1); margin-left: .1em; }
  .an-bar { width: min(320px, 60vw); height: 1px; background: var(--color-line); }
  .an-bar b { display: block; height: 100%; background: var(--color-c1); transform-origin: left; scale: 0 1; }
  :global(html[data-tier="static"]) .an-loader, :global(html.no-js) .an-loader { display: none; }

  .an { position: relative; }
  .an-stage { position: relative; height: 100svh; min-height: 560px; overflow: hidden; background: radial-gradient(55% 60% at 60% 50%, oklch(0.19 0.012 60) 0%, var(--color-bg) 72%); }
  .an-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background: linear-gradient(90deg, color-mix(in oklch, var(--color-fg) 5%, transparent) 1px, transparent 1px) 0 0 / 80px 80px, linear-gradient(color-mix(in oklch, var(--color-fg) 5%, transparent) 1px, transparent 1px) 0 0 / 80px 80px;
    mask-image: radial-gradient(60% 60% at 60% 50%, #000, transparent); }
  .an-canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s var(--ease-primary); }
  .an-canvas:global(.is-live) { opacity: 1; }
  .an-tags { position: absolute; inset: 0; pointer-events: none; }
  .an-scrim { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(38% 42% at 14% 24%, color-mix(in oklch, var(--color-bg) 88%, transparent), transparent 75%), linear-gradient(transparent 78%, color-mix(in oklch, var(--color-bg) 80%, transparent)); }
  .an-tags :global(.an-tag) { position: absolute; left: 0; top: 0; display: flex; align-items: center; gap: 8px; opacity: 0; will-change: transform; font: .75rem/1 var(--font-code); letter-spacing: .06em; text-transform: uppercase; color: var(--color-fg); white-space: nowrap; }
  .an-tags :global(.an-tag i) { width: 44px; height: 1px; background: var(--color-c1); }
  .an-tags :global(.an-tag b) { font-weight: inherit; color: var(--color-c1); }
  .an-tags :global(.an-tag em) { font-style: normal; color: var(--color-muted); margin-left: 6px; }
  .an-live { position: absolute; left: 0; top: 0; overflow: hidden; border-radius: 2px; opacity: 0; visibility: hidden; transition: opacity .5s var(--ease-primary), visibility 0s .5s; box-shadow: 0 0 0 1px color-mix(in oklch, var(--color-c1) 60%, transparent), 0 40px 120px -40px color-mix(in oklch, var(--color-c1) 45%, transparent); }
  .an-live.is-on { opacity: 1; visibility: visible; transition-delay: .1s, 0s; }
  .an-live iframe { width: 1440px; height: 900px; border: 0; transform-origin: 0 0; background: var(--color-bg); }
  .an-tags :global(.an-tag::before) { content: ""; position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%; background: var(--color-c1); }

  .an-head { position: absolute; inset: calc(var(--header-h, 72px) + 24px) 0 auto; pointer-events: none; }
  .an-title { font-size: clamp(2.4rem, 5.4vw, 5.8rem); margin-top: 14px; max-width: 9ch; }
  .an-hint { pointer-events: auto; margin-top: 18px; display: inline-flex; gap: 10px; align-items: center; padding: 0; border: 0; background: none; color: var(--color-muted); cursor: pointer; }
  .an-hint::before { content: ""; width: 6px; height: 6px; background: var(--color-c1); animation: an-blink 1.4s steps(2) infinite; }
  .an-hint:hover { color: var(--color-fg); }
  .an-hint:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @keyframes an-blink { 50% { opacity: 0 } }

  .an-cards { position: absolute; right: var(--gutter); bottom: clamp(96px, 14vh, 140px); width: min(340px, 34vw); display: grid; }
  .an-card { grid-area: 1 / 1; display: grid; gap: 6px; justify-items: start; padding: 18px 20px 20px; border-radius: var(--radius-panel); background: color-mix(in oklch, var(--color-bg) 72%, transparent); box-shadow: inset 0 0 0 1px var(--color-line); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    opacity: 0; translate: 0 12px; visibility: hidden; transition: opacity .5s var(--ease-primary), translate .5s var(--ease-primary), visibility 0s .5s, box-shadow .5s var(--ease-primary); }
  .an-card[aria-current] { opacity: 1; translate: 0 0; visibility: visible; transition-delay: .3s, .3s, 0s, 0s; }
  :global(.is-assembled) .an-card[aria-current] { box-shadow: inset 0 0 0 1px var(--color-c1); }
  .an-cards { transition: right .7s var(--ease-primary), bottom .7s var(--ease-primary); }
  @media (min-width: 761px) { :global(.is-assembled) .an-cards { right: calc(100% - var(--gutter) - min(340px, 34vw)); bottom: clamp(110px, 16vh, 160px); } }
  .an-shot { display: none; }
  .an-meta { font: .75rem/1.3 var(--font-code); letter-spacing: .06em; color: var(--color-c1); text-transform: uppercase; }
  .an-meta b { font-weight: inherit; color: var(--color-fg); }
  .an-name { font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1; letter-spacing: -0.04em; font-variation-settings: "wght" 600; text-transform: uppercase; }
  .an-kind { font-size: .95rem; margin-bottom: 8px; }

  .an-controls { position: absolute; left: var(--gutter); bottom: clamp(28px, 5vh, 48px); display: flex; align-items: center; gap: 14px; }
  .an-controls ol { display: flex; gap: 6px; }
  .an-controls ol button { display: flex; gap: 8px; align-items: baseline; padding: 8px 12px; border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--color-muted); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; font-variation-settings: "wght" 600; cursor: pointer; box-shadow: inset 0 0 0 1px transparent; transition: color .3s var(--ease-primary), box-shadow .3s var(--ease-primary); }
  .an-controls ol button b { font: inherit; font-family: var(--font-code); color: var(--color-c1); }
  .an-controls ol button:hover, .an-controls ol button[aria-current] { color: var(--color-fg); box-shadow: inset 0 0 0 1px var(--color-line); }
  .an-arrow { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--color-fg); cursor: pointer; box-shadow: inset 0 0 0 1px var(--color-line); transition: box-shadow .3s var(--ease-primary); }
  .an-arrow:hover { box-shadow: inset 0 0 0 1px var(--color-fg); }
  .an-arrow:first-child span { display: grid; rotate: 180deg; }
  .an-arrow:focus-visible, .an-controls ol button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .an-end { position: absolute; right: var(--gutter); bottom: clamp(28px, 5vh, 48px); display: flex; gap: 16px; align-items: center; }
  .an-end-title { color: var(--color-muted); font-size: .95rem; }
  /* seven projects fill the bar: the question only fits on wide screens; the button stays */
  @media (max-width: 1599px) { .an-end-title { display: none; } }
  /* below that only the current project keeps its name */
  @media (max-width: 1439px) { .an-controls ol button:not([aria-current]) span { display: none; } }

  @media (max-width: 760px) {
    .an-title { font-size: clamp(1.9rem, 9vw, 2.8rem); max-width: 12ch; }
    .an-hint { margin-top: 12px; }
    .an-tags :global(.an-tag) { font-size: .62rem; }
    .an-tags :global(.an-tag em) { display: none; }
    .an-cards { left: var(--gutter); right: var(--gutter); width: auto; bottom: 150px; }
    .an-card { padding: 14px 16px; }
    .an-controls { left: 0; right: 0; justify-content: center; bottom: 92px; }
    .an-controls ol button span { display: none; }
    .an-end { display: none; }
    .an-tags :global(.an-tag i) { width: 14px; }
  }

  /* reduced motion / no WebGL: the projects as a list */
  :global(html[data-tier="static"]) .an-stage { height: auto; min-height: 0; padding: calc(var(--header-h, 72px) + 24px) 0 var(--section); }
  :global(html[data-tier="static"]) .an-canvas, :global(html[data-tier="static"]) .an-controls, :global(html[data-tier="static"]) .an-hint, :global(html[data-tier="static"]) .an-tags { display: none; }
  :global(html[data-tier="static"]) .an-head, :global(html[data-tier="static"]) .an-cards, :global(html[data-tier="static"]) .an-end { position: static; }
  :global(html[data-tier="static"]) .an-cards { width: auto; margin: 40px var(--gutter) 32px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  :global(html[data-tier="static"]) .an-card { grid-area: auto; opacity: 1; translate: none; visibility: visible; }
  :global(html[data-tier="static"]) .an-shot { display: block; width: 100%; height: auto; border-radius: 8px; margin-bottom: 8px; }
  :global(html[data-tier="static"]) .an-end { margin-inline: var(--gutter); }
</style>
